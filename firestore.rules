rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user may read and write only within their own subtree:
    //   users/{uid}                      (profile)
    //   users/{uid}/activities/{id}      (prayer | bible_reading | confession)
    //   users/{uid}/journalEntries/{id}  (journal)
    //   users/{uid}/stats/summary        (streaks + totals)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default (no catch-all allow).
  }
}
