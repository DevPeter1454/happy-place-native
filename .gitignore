# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files / secrets (keep .env.example committed)
.env
.env.*
!.env.example

# Firebase (native config + CLI artifacts; not used by the JS SDK but ignored regardless)
google-services.json
GoogleService-Info.plist
.firebase/
firebase-debug.log*

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android


.stitch/

